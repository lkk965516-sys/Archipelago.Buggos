<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

   
    <AssemblyName>HarmonyModPlugin</AssemblyName>
    <RootNamespace>HarmonyModPlugin</RootNamespace>
    <Product>My first plugin</Product>
    <Version>1.0.0</Version>

    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <GameDir>C:\Users\lkk96\Documents\bugs\Buggos</GameDir>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
 
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <ItemGroup>
      <PluginFiles Include="$(OutDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(GameDir)\BepInEx\plugins\HarmonyModPlugin" />
  </Target>

</Project>
