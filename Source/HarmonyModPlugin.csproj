<!-- set game dir first with code below
$env:BUGGOS_GAME_DIR = "C:\ect" -->

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>ArchipelagoBuggos</AssemblyName>
    <RootNamespace>ArchipelagoBuggos</RootNamespace>
    <Product>Archipelago Buggos</Product>
    <Version>1.0.0</Version>

    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <GameDir Condition="'$(GameDir)' == ''">$(BUGGOS_GAME_DIR)</GameDir>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.788" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
  </ItemGroup>

  <ItemGroup>

    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>

  <!-- copy the built plugin and its dependencies into the game after every build-->
  <Target Name="CopyToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <ItemGroup>
      <PluginFiles Include="$(OutDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(GameDir)\BepInEx\plugins\HarmonyModPlugin" />
  </Target>

  

</Project>
